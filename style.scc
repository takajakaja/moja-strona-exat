/* style.css */

/* Reset i podstawowe style */
body, html {margin:0; padding:0; font-family: Arial,sans-serif;}
body {color:#333; line-height:1.6;}
a {text-decoration:none; color:inherit;}

/* Nagłówek */
header {background:#1a73e8; color:#fff; text-align:center; padding:80px 20px;}
header h1 {font-size:3em; margin:0;}
header p {font-size:1.2em; margin:15px 0 25px;}
header a.cta {background:#fff; color:#1a73e8; padding:15px 30px; border-radius:5px; font-weight:bold; display:inline-block; transition:0.3s;}
header a.cta:hover {background:#e8e8e8;}

/* Sekcje */
section {padding:60px 20px; max-width:1200px; margin:0 auto;}
h2 {text-align:center; margin-bottom:50px; font-size:2em;}

/* Usługi */
.services {display:flex; flex-wrap:wrap; justify-content:space-around; gap:25px;}
.service {flex:1 1 300px; background:#f4f4f4; border-radius:10px; text-align:center; padding:25px;}
.service img {width:70px; height:70px; margin-bottom:15px;}
.service h3 {margin-top:0;}

/* Formularz */
form {max-width:600px; margin:0 auto; display:flex; flex-direction:column; gap:15px;}
input, textarea {padding:12px; border:1px solid #ccc; border-radius:5px; width:100%;}
button.submit {padding:15px; background:#1a73e8; color:#fff; border:none; border-radius:5px; cursor:pointer;}
button.submit:hover {background:#155ab6;}

/* Stopka */
footer {background:#222; color:#fff; padding:30px 20px; text-align:center;}

/* Media queries */
@media(max-width:768px){
    .services {flex-direction:column; align-items:center;}
}
